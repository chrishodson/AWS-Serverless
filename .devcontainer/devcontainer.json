// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Ubuntu",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	"features": {
		"ghcr.io/devcontainers/features/node:1": {	"version": "lts" },
		"ghcr.io/devcontainers/features/python:1": {
			"version": "3.10"
		},
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/terraform:1": {}
	},

	// Ensure Python and pip are available and install pyyaml after container creation
	"postCreateCommand": "python3 -m pip install --upgrade pip && python3 -m pip install pyyaml",

	// Add the official Python feature to ensure a supported Python environment is available

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	"mounts": [
	"source=${localEnv:HOME}/.terraform-plugin-cache,target=/terraform-plugin-cache,type=bind"
	],

	// Configure tool-specific properties.
	// "customizations": {},
	"customizations": {
    "vscode": {
      "extensions": [
        "hashicorp.terraform"
      ]
    }
  }

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
